{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newcomer",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/mcp", "/mcp/*", "/api/*"] },
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "CACHE", "id": "7f2c02270c054ea8942e72bf96e68bf6" }],
  "vars": { "QLOO_BASE_URL": "https://hackathon.api.qloo.com" },
  "observability": { "enabled": true }
}
